# Build the contextual-history-helper zsh module.
#
# Usage:
#   make                                  Auto-detect zsh version, fetch +
#                                         configure source into ./build/zsh-X.Y/,
#                                         then build zsh/contextual_history.<so|bundle>.
#   make ZSH_SRC=/path/to/zsh-X.Y         Use an existing configured zsh
#                                         source tree; skip the fetch/configure.
#   make install                          Copy the .so/.bundle into a dir on
#                                         your $module_path. Override target
#                                         with DEST=/path.
#   make clean                            Remove just our build artefacts.
#   make distclean                        Also remove build/ (the fetched zsh
#                                         source tree).
#
# We need a ./configure'd zsh source tree (NOT a fully-built one) for the
# header set: config.h is generated by configure; zsh.h, zsh_system.h, etc.
# are checked into the tarball. Our contextual_history.c declares the few zsh
# functions it uses by hand, so we don't need the .epro/.mdh files that a
# full `make` of zsh would generate.

# --- Version + paths -------------------------------------------------------

# Version of the running zsh, used to pick a matching source tarball. Use
# `zsh --version` (which doesn't source rc files) rather than `zsh -c
# 'echo $ZSH_VERSION'` (which sources zshenv and could pick up plugin
# managers / debug-printing plugins that pollute stdout).
ZSH_VERSION := $(shell zsh --version 2>/dev/null | awk '{print $$2}')
ifeq ($(ZSH_VERSION),)
$(error Could not determine zsh version. Is zsh on PATH? Or pass ZSH_VERSION=X.Y explicitly.)
endif

BUILD_DIR ?= build
ZSH_SRC   ?= $(BUILD_DIR)/zsh-$(ZSH_VERSION)
TARBALL    = $(BUILD_DIR)/zsh-$(ZSH_VERSION).tar.xz

# SourceForge canonical URL. curl -L follows the mirror redirects.
ZSH_URL ?= https://sourceforge.net/projects/zsh/files/zsh/$(ZSH_VERSION)/zsh-$(ZSH_VERSION).tar.xz/download

# --- Toolchain -------------------------------------------------------------

CC      ?= cc
INSTALL ?= install

# Module gets dropped into a `zsh/` subdir to match $module_path conventions.
SODIR = zsh

# Platform-specific shared-object linking.
ifeq ($(shell uname -s),Darwin)
  LDFLAGS_SHARED = -bundle -undefined dynamic_lookup
  SOEXT = bundle
else
  LDFLAGS_SHARED = -shared
  SOEXT = so
endif

CFLAGS  ?= -O2 -Wall -fPIC
ZSH_INCLUDES = -I$(ZSH_SRC)/Src -I$(ZSH_SRC)
SOFILE = $(SODIR)/contextual_history.$(SOEXT)

# --- Targets ---------------------------------------------------------------

all: $(SOFILE)

$(BUILD_DIR):
	mkdir -p $@

# Download the zsh source tarball matching the running zsh's version.
$(TARBALL): | $(BUILD_DIR)
	@echo "fetching zsh-$(ZSH_VERSION) source tarball..."
	curl -fsSL -o $@ "$(ZSH_URL)"

# Unpack into $(ZSH_SRC). The `configure` file presence is our marker for
# "tarball was unpacked here".
$(ZSH_SRC)/configure: $(TARBALL)
	@echo "unpacking zsh-$(ZSH_VERSION) into $(ZSH_SRC)..."
	mkdir -p $(ZSH_SRC)
	tar -xf $(TARBALL) -C $(ZSH_SRC) --strip-components=1
	touch $@

# Run ./configure (generates config.h) AND `make` (generates auxiliary
# headers like zshcurses.h, zshterm.h, sigcount.h, etc. via awk/sed steps
# in zsh's build). The full zsh build takes ~10-15s on modern hardware, a
# one-time cost. We use Src/zshcurses.h as a marker file because
# zsh_system.h includes it - if it's present, our compile will succeed.
$(ZSH_SRC)/Src/zshcurses.h: $(ZSH_SRC)/configure
	@echo "configuring zsh-$(ZSH_VERSION)..."
	cd $(ZSH_SRC) && ./configure --quiet
	@echo "building zsh-$(ZSH_VERSION) (one-time, generates aux headers)..."
	cd $(ZSH_SRC) && $(MAKE) -s

$(SODIR):
	mkdir -p $@

contextual_history.o: contextual_history.c $(ZSH_SRC)/Src/zshcurses.h
	$(CC) $(CFLAGS) -DMODULE $(ZSH_INCLUDES) -c -o $@ $<

$(SOFILE): contextual_history.o | $(SODIR)
	$(CC) $(LDFLAGS_SHARED) -o $@ $<
	@echo
	@echo "Built $(SOFILE)."
	@echo "Two ways to use it:"
	@echo "  1. CONTEXTUAL_HISTORY_USE_MODULE=true in your zshrc before sourcing"
	@echo "     the plugin (loads it from this directory directly)."
	@echo "  2. 'make install' to copy it into your \$$module_path."

# Install into the FIRST entry of the user's $module_path. Override with
# DEST=/path on the command line.
install: $(SOFILE)
	@DEST="$${DEST:-$$(zsh -c 'print -- $${module_path[1]}')}"; \
	if [ -z "$$DEST" ]; then \
	  echo "ERROR: could not determine install dir from \$$module_path."; \
	  echo "Pass DEST=/your/install/dir explicitly."; \
	  exit 1; \
	fi; \
	mkdir -p "$$DEST/$(SODIR)"; \
	$(INSTALL) -m 0644 $(SOFILE) "$$DEST/$(SODIR)/"; \
	echo "Installed to $$DEST/$(SOFILE)"

clean:
	rm -rf contextual_history.o $(SODIR)

distclean: clean
	rm -rf $(BUILD_DIR)

.PHONY: all install clean distclean
